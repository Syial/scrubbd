root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Corpus files are test data: whitespace is part of the cases
# (e.g. the `-- ` signature delimiter in tests/corpus2/25-email-message.eml).
[tests/corpus*/*]
trim_trailing_whitespace = false
insert_final_newline = unset
indent_style = unset
indent_size = unset
